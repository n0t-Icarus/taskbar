      "name": "msvc-x64",
      "configurePreset": "msvc-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-x64",
      "configurePreset": "msvc-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
